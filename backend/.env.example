NODE_ENV=development
PORT=3000

JWT_SECRET=replace-with-at-least-32-random-bytes
BCRYPT_ROUNDS=12
AUTH_COOKIE_SAME_SITE=lax
ALLOW_ENV_ADMIN=false

# Google OAuth web client (server only; register this exact callback at Google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# Separate random secret, at least 32 bytes, for email-code HMACs.
AUTH_CHALLENGE_SECRET=
# Render free: use HTTPS relay instead of SMTP. Dedicated random secret, different
# from AUTH_CHALLENGE_SECRET; same value in the Vercel server environment.
AUTH_MAIL_RELAY_URL=
AUTH_MAIL_RELAY_SECRET=
# SMTP delivery to linked Gmail recipients. TLS only: port 465 or STARTTLS 587.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=465
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
AUTH_EMAIL_FROM=

FRONTEND_URL=http://localhost:4200
FRONTEND_URLS=
API_BASE_URL=http://localhost:3000
TRUST_PROXY_HOPS=1

REQUEST_BODY_LIMIT_MB=5
MEDIA_MAX_FILE_SIZE_MB=25

DB_USER=
DB_HOST=127.0.0.1
DB_NAME=
DB_PASSWORD=
DB_PORT=5432
DB_POOL_MAX=10
DB_POOL_WARM_COUNT=2
DB_CONNECTION_TIMEOUT_MS=15000
DB_MIGRATION_TIMEOUT_MS=120000

DATABASE_URL=
DB_SSL_REJECT_UNAUTHORIZED=true

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=paragon-media

LOCAL_STORAGE_URL=http://localhost:3000/uploads

# Special Issue PDF processing
SPECIAL_ISSUE_PDF_MAX_UPLOAD_MB=50
SPECIAL_ISSUE_UPLOAD_RATE_LIMIT=10
PDF_PROCESSOR_ENABLED=true
PDF_PROCESSOR_REQUIRED=false
PDF_GHOSTSCRIPT_PATH=gs
PDF_COMPRESSION_PROFILE=ebook
PDF_COMPRESSION_MIN_SAVINGS_PERCENT=5
PDF_COMPRESSION_FALLBACK=original
PDF_MAX_PAGE_COUNT=1000
PDF_PROCESS_TIMEOUT_MS=45000
PDF_PROCESSING_CONCURRENCY=1

ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_STAFF_ID=
